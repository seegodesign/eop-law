---
import { getCollection } from 'astro:content';

const practiceAreas = (await getCollection('practiceAreas'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

interface Props {
  heading: string;
  description: string;
  phone: string;
  email: string;
  addressLines: string[];
  officeHours: string[];
  mapUrl?: string;
  parkingInfo?: string;
}

const { heading, description, phone, email, addressLines, officeHours, mapUrl, parkingInfo } = Astro.props;
---

<section id="contact" class="py-32 bg-background">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16">
      <div>

        <h2 class="text-4xl md:text-6xl text-primary mb-8">{heading}</h2>

        <p class="text-lg text-muted-foreground mb-12 leading-relaxed">{description}</p>

        <div class="space-y-8">
          <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0">☎</div>
            <div>
              <h4 class="text-xl text-primary mb-2">Phone</h4>
              <p class="text-muted-foreground">
                <a class="hover:text-accent underline underline-offset-4 transition-colors decoration-accent" href={`tel:${phone}`}>{phone}</a>
              </p>
            </div>
          </div>

          <!-- <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0">✉</div>
            <div>
              <h4 class="text-xl text-primary mb-2">Email</h4>
              <p class="text-muted-foreground">
                <a class="hover:text-accent underline underline-offset-4 transition-colors decoration-accent" href={`mailto:${email}`}>{email}</a>
              </p>
            </div>
          </div> -->

          <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0">⌂</div>
            <div>
              <h4 class="text-xl text-primary mb-2">Address</h4>
              {mapUrl ? (
                <a
                  href={mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground hover:text-accent underline underline-offset-4 transition-colors decoration-accent"
                >
                  {addressLines[0]}<br />{addressLines[1]}
                </a>
              ) : (
                <p class="text-muted-foreground">{addressLines[0]}<br />{addressLines[1]}</p>
              )}
              {parkingInfo && (
                <p class="mt-2 text-sm text-muted-foreground italic">{parkingInfo}</p>
              )}
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-14 h-24 text-lg bg-accent/10 flex items-center justify-center flex-shrink-0">◷</div>
            <div>
              <h4 class="text-xl text-primary mb-2">Office Hours</h4>
              <p class="text-muted-foreground">{officeHours[0]}<br />{officeHours[1]}</p>
            </div>
          </div>
        </div>

        <iframe
          title="Elliott, Ostrander & Preston office location"
          src="https://maps.google.com/maps?q=707+SW+Washington+St+Suite+1500,Portland,OR+97205&t=&z=16&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="280"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full mt-8"
        ></iframe>
      </div>

      <div class="bg-accent/50 p-12">
        <h3 class="text-3xl mb-8">Send us a message</h3>

        <form class="space-y-6">
          <div>
            <label for="name" class="block mb-2">Full Name</label>
            <input type="text" id="name" class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white" placeholder="John Doe" />
          </div>

          <div>
            <label for="email" class="block mb-2">Email Address</label>
            <input type="email" id="email" class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white" placeholder="john@example.com" />
          </div>

          <div>
            <label for="phone" class="block mb-2">Phone Number</label>
            <input type="tel" id="phone" class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white" placeholder="(555) 123-4567" />
          </div>

          <div>
            <label for="case-type" class="block mb-2">Case Type</label>
            <select id="case-type" class="w-full px-6 py-4 border focus:outline-none focus:border-accent bg-white">
              <option value="" disabled selected>Select a practice area</option>
              {practiceAreas.map((area) => (
                <option value={area.id}>{area.data.title}</option>
              ))}
              <option value="other">Other / Not Sure</option>
            </select>
          </div>

          <div>
            <label for="message" class="block mb-2">Message</label>
            <textarea id="message" rows={5} class="w-full px-6 py-4 border placeholder focus:outline-none focus:border-accent bg-white resize-none" placeholder="Tell us about your legal needs..."></textarea>
          </div>

          <button type="submit" class="w-full px-8 py-5 bg-accent text-accent-foreground hover:bg-white transition-colors">
            Submit Inquiry
          </button>

          <p class="text-xs text-muted-foreground leading-relaxed">
            Submitting this form does not establish an attorney-client relationship. Do not submit confidential or time-sensitive information.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
