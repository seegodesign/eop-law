---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/astro/Header.astro';
import Footer from '../../components/astro/Footer.astro';
import PageHero from '../../components/astro/PageHero.astro';
import page from '../../data/home.json';
import firmInfo from '../../data/firm-info.json';
import courthousePanelImg from '../../images/courthouse-panel.webp';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export const getStaticPaths = async () => {
  const areas = await getCollection('practiceAreas');
  return areas.map((entry) => ({
    params: { slug: entry.id },
    props: { area: entry },
  }));
};

interface Props {
  area: CollectionEntry<'practiceAreas'>;
}

const { area } = Astro.props as Props;

const {
  title,
  description,
  overview,
  services,
  clientProblem,
  faqs,
} = area.data;

// Match attorneys whose practiceAreas overlap with this page's title keywords
const allAttorneys = await getCollection('attorneys');
const matchedAttorneys = allAttorneys
  .filter((a) =>
    (a.data.practiceAreas ?? []).some((pa) =>
      title.toLowerCase().includes(pa.toLowerCase()) ||
      pa.toLowerCase().includes(title.toLowerCase().split(' ')[0])
    )
  )
  .sort((a, b) => a.data.order - b.data.order);

const phoneHref = `tel:${firmInfo.phone.replace(/\s/g, '')}`;
const yearsOfExperience = new Date().getFullYear() - 1995;
---

<BaseLayout
  title={`${title} | Practice Areas | EOP Law`}
  description={description}
>
  <div class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 bg-white">

      <!-- Hero -->
      <PageHero
        title={`Portland ${title} Attorneys`}
        subtitle={description}
        backgroundImageSrc={courthousePanelImg.src}
        containerMaxWidthClass="max-w-5xl"
      />

      <!-- Hero CTA bar -->
      <div class="bg-primary py-5">
        <div class="mx-auto w-full max-w-5xl px-6 flex flex-wrap items-center justify-between gap-4">
          <p class="text-white/90 text-sm md:text-base font-sans">
            Ready to discuss your matter? Our attorneys are here to help.
          </p>
          <a
            href="/contact-us"
            class="inline-flex items-center justify-center px-7 py-3 bg-accent text-accent-foreground font-sans font-semibold text-sm whitespace-nowrap transition-colors hover:bg-white hover:text-primary"
          >
            Schedule Your Free Case Evaluation
          </a>
        </div>
      </div>

      <div class="mx-auto w-full max-w-5xl px-6 py-12 md:py-16 space-y-16">

        <!-- Overview -->
        <section class="space-y-5 text-[1.05rem] leading-relaxed text-neutral-700">
          {overview.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>

        <!-- Client Problem -->
        {clientProblem.length > 0 && (
          <section class="bg-neutral-50 border-l-4 border-accent px-8 py-8 space-y-4">
            <h2 class="font-serif text-2xl text-primary md:text-3xl">Common Challenges We Solve</h2>
            <ul class="mt-3 space-y-3 text-[1.05rem] leading-relaxed text-neutral-700">
              {clientProblem.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-1 text-accent font-bold flex-shrink-0">&#10003;</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Services -->
        <section>
          <h2 class="font-serif text-2xl text-primary md:text-3xl">Key Services</h2>
          <ul class="mt-5 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-[1.05rem] leading-relaxed text-neutral-700">
            {services.map((service) => (
              <li class="flex gap-2">
                <span class="text-accent font-bold flex-shrink-0">&#10003;</span>
                <span>{service}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Trust Markers -->
        <section class="bg-primary text-white px-8 py-10">
          <h2 class="font-serif text-2xl md:text-3xl mb-8">Why Clients Trust EOP Law</h2>
          <div class="grid sm:grid-cols-3 gap-8 text-center">
            <div>
              <p class="font-serif text-4xl text-accent">{yearsOfExperience}+</p>
              <p class="mt-1 text-sm text-white/80 uppercase tracking-wider">Years of Practice</p>
            </div>
            <div>
              <p class="font-serif text-4xl text-accent">500+</p>
              <p class="mt-1 text-sm text-white/80 uppercase tracking-wider">Cases Handled</p>
            </div>
            <div>
              <p class="font-serif text-4xl text-accent">5</p>
              <p class="mt-1 text-sm text-white/80 uppercase tracking-wider">Practice Areas</p>
            </div>
          </div>
          <p class="mt-8 text-white/75 text-sm leading-relaxed max-w-2xl mx-auto text-center">
            Elliott, Ostrander &amp; Preston has served Oregon and Washington businesses and individuals since 1995. Our attorneys are admitted to Oregon, Washington, and California state bars and appear in state and federal courts throughout the region.
          </p>
        </section>

        <!-- Attorney Profiles -->
        {matchedAttorneys.length > 0 && (
          <section>
            <h2 class="font-serif text-2xl text-primary md:text-3xl">Attorneys Who Handle This Area</h2>
            <div class="mt-6 grid sm:grid-cols-2 gap-6">
              {matchedAttorneys.map((attorney) => (
                <a
                  href={`/our-attorneys/${attorney.id}`}
                  class="flex gap-5 border border-neutral-200 p-5 hover:border-accent transition-colors group"
                >
                  {attorney.data.photo ? (
                    <img
                      src={attorney.data.photo}
                      alt={attorney.data.name}
                      class="w-20 h-20 object-cover object-top flex-shrink-0 grayscale group-hover:grayscale-0 transition-all"
                    />
                  ) : (
                    <div class="w-20 h-20 flex-shrink-0 bg-neutral-100 flex items-center justify-center text-2xl text-neutral-400 font-serif">
                      {attorney.data.name.charAt(0)}
                    </div>
                  )}
                  <div class="space-y-1">
                    <p class="font-serif text-lg text-primary group-hover:text-accent transition-colors">
                      {attorney.data.name}
                    </p>
                    <p class="text-xs text-neutral-500 uppercase tracking-wide">
                      {(attorney.data.practiceAreas ?? []).join(' · ')}
                    </p>
                    {attorney.data.specialty && (
                      <p class="text-sm text-neutral-600 leading-snug line-clamp-3">
                        {attorney.data.specialty}
                      </p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- FAQs -->
        {faqs.length > 0 && (
          <section>
            <h2 class="font-serif text-2xl text-primary md:text-3xl">Frequently Asked Questions</h2>
            <dl class="mt-6 divide-y divide-neutral-200">
              {faqs.map((faq) => (
                <details class="group py-5">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
                    <dt class="font-serif text-lg text-primary">{faq.question}</dt>
                    <span class="flex-shrink-0 text-accent transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <dd class="mt-3 text-[1.05rem] leading-relaxed text-neutral-700">{faq.answer}</dd>
                </details>
              ))}
            </dl>
          </section>
        )}

        <!-- Contact -->
        <section class="bg-neutral-50 border border-neutral-200 px-8 py-10">
          <h2 class="font-serif text-2xl text-primary md:text-3xl">Contact Our Portland Office</h2>
          <div class="mt-8 grid md:grid-cols-2 gap-10">

            <div class="space-y-6 text-neutral-700 text-[1.05rem]">
              <div>
                <p class="font-semibold text-primary">Phone</p>
                <a
                  href={phoneHref}
                  class="text-accent hover:underline"
                >
                  {firmInfo.phone}
                </a>
                {firmInfo.tollFree && (
                  <p class="text-sm text-neutral-500 mt-1">
                    Toll-free: <a href={`tel:${firmInfo.tollFree.replace(/\s/g, '')}`} class="hover:underline">{firmInfo.tollFree}</a>
                  </p>
                )}
              </div>
              <div>
                <p class="font-semibold text-primary">Email</p>
                <a href={`mailto:${firmInfo.email}`} class="text-accent hover:underline">{firmInfo.email}</a>
              </div>
              <div>
                <p class="font-semibold text-primary">Address</p>
                <address class="not-italic leading-relaxed">
                  {firmInfo.addressLines.map((line) => (
                    <span>{line}<br /></span>
                  ))}
                </address>
                <a
                  href={firmInfo.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-md text-accent hover:underline mt-1 inline-block"
                >
                  Get directions
                </a>
              </div>
              <div>
                <p class="font-semibold text-primary">Office Hours</p>
                {firmInfo.officeHours.map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            </div>

            <form class="space-y-4">
              <div>
                <label for="pa-name" class="block text-sm font-medium text-neutral-700 mb-1">Full Name</label>
                <input
                  type="text"
                  id="pa-name"
                  name="name"
                  autocomplete="name"
                  class="w-full px-4 py-3 border border-neutral-300 focus:outline-none focus:border-accent bg-white text-neutral-900"
                  placeholder="Jane Smith"
                />
              </div>
              <div>
                <label for="pa-email" class="block text-sm font-medium text-neutral-700 mb-1">Email Address</label>
                <input
                  type="email"
                  id="pa-email"
                  name="email"
                  autocomplete="email"
                  class="w-full px-4 py-3 border border-neutral-300 focus:outline-none focus:border-accent bg-white text-neutral-900"
                  placeholder="jane@example.com"
                />
              </div>
              <div>
                <label for="pa-phone" class="block text-sm font-medium text-neutral-700 mb-1">Phone Number</label>
                <input
                  type="tel"
                  id="pa-phone"
                  name="phone"
                  autocomplete="tel"
                  class="w-full px-4 py-3 border border-neutral-300 focus:outline-none focus:border-accent bg-white text-neutral-900"
                  placeholder="(503) 555-0100"
                />
              </div>
              <div>
                <label for="pa-message" class="block text-sm font-medium text-neutral-700 mb-1">Describe Your Matter</label>
                <textarea
                  id="pa-message"
                  name="message"
                  rows={4}
                  class="w-full px-4 py-3 border border-neutral-300 focus:outline-none focus:border-accent bg-white text-neutral-900 resize-none"
                  placeholder={`Tell us about your ${title.toLowerCase()} matter...`}
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full px-6 py-4 bg-primary text-white font-semibold hover:bg-accent hover:text-accent-foreground transition-colors"
              >
                Request a Free Case Evaluation
              </button>
            </form>
          </div>
        </section>

        <!-- Bottom nav links -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/practice-areas"
            class="inline-flex items-center justify-center px-6 py-3 border border-primary text-primary transition-colors hover:border-accent hover:text-accent"
          >
            ← Back To Practice Areas
          </a>
        </div>

      </div>
    </main>
    <Footer
      summary={firmInfo.summary}
      practiceLinks={page.footer.practiceLinks}
      companyLinks={page.footer.companyLinks}
      legalLinks={page.footer.legalLinks}
      socialLinks={firmInfo.socialLinks}
      copyright={firmInfo.copyright}
      phone={firmInfo.phone}
      addressLines={firmInfo.addressLines}
    />
  </div>
</BaseLayout>
