---
interface Practice {
  title: string;
  description: string;
  href: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  items: Practice[];
}

const { eyebrow, heading, description, items } = Astro.props;
---

<section id="practice" class="py-32 bg-background">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="text-center mb-20">
      <div class="inline-block px-6 py-2 bg-accent/10 border border-accent/30 mb-6">
        <span class="text-accent-foreground">{eyebrow}</span>
      </div>
      <h2 class="text-4xl md:text-6xl text-primary mb-6">{heading}</h2>
      <p class="text-xl text-muted-foreground max-w-3xl mx-auto">{description}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {items.map((practice) => (
        <article class="group p-10 bg-white border border-border hover:border-accent transition-all duration-300 hover:shadow-xl">
          <div class="w-16 h-16 bg-accent/10 flex items-center justify-center mb-6 group-hover:bg-accent transition-colors">
            <span class="text-accent group-hover:text-accent-foreground transition-colors text-xl">⚖</span>
          </div>
          <h3 class="text-xl text-primary mb-4">{practice.title}</h3>
          <p class="text-muted-foreground leading-relaxed">{practice.description}</p>
          <a href={practice.href} class="mt-6 inline-block text-accent hover:underline">Read More...</a>
        </article>
      ))}
    </div>
  </div>
</section>
