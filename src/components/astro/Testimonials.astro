---
interface Testimonial {
  quote: string;
  author: string;
  title: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  items: Testimonial[];
}

const { eyebrow, heading, items } = Astro.props;
---

<section id="resources" class="py-32 bg-accent/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="text-center mb-20">
      <div class="inline-block px-6 py-2 bg-accent/10 border border-accent/30 mb-6">
        <span class="text-accent-foreground">{eyebrow}</span>
      </div>
      <h2 class="text-4xl md:text-6xl text-primary mb-6">{heading}</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {items.map((testimonial) => (
        <article class="bg-white p-10 border border-border">
          <div class="flex gap-0.5 mb-4" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-yellow-400" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-lg text-foreground mb-8 leading-relaxed">{testimonial.quote}</p>
          <div class="border-t border-border pt-6">
            <div class="text-primary mb-1">{testimonial.author}</div>
            <div class="text-muted-foreground">{testimonial.title}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
